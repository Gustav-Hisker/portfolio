<canvas id="ComplexFunc" width="2000", height="1000" style='width:100%' class="border-black border-2"></canvas>

<div class="p-0 md:p-2">
    <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-full border p-1 md:p-4 md:text-xl align-middle">
        <legend class="fieldset-legend">Enter Function to display</legend>

        <div class="flex align-middle">
        <h2 class="text-l md:text-2xl flex-none p-0.5 md:p-2">f(z) =</h2>
        <input class="w-full text-l md:text-2xl p-0.5 md:p-2" id="function-input" type="text" name="function" placeholder="e**z">
        </div>
        <p class="text-info text-xs md:text-xl p-0.5 md:p-2">Allowed symbols and Operators: z, (Complex) Numbers (e.g 13.37, 42i, 13 + 23i, ...), +, -, *, /, ** (= ^), i, e, t(=τ), p(=π), sin, cos, sinh, cosh, Re, Im, conj (= conjuate)), abs, |⋅|, arg</p>
    </fieldset>

    <div class="grid auto-rows-min landscape:grid-cols-2 portrait:grid-cols-1 gap-3">
        <fieldset class="fieldset bg-base-200 border-base-300 rounded-box w-auto border p-1 md:p-3 md:text-xl align-middle">
            <legend class="fieldset-legend">Select object to display</legend>

            <div>
                <input type="radio" id="radioGrid" name="displayObj" value="Grid" class="radio" checked />
                <label for="Grid" class="text-base-content label p-2">Grid</label>
            </div>

            <div>
                <input type="radio" id="radioCirc" name="displayObj" class="radio" value="Circle"/>
                <label for="Circle" class="text-base-content label p-2">Circle</label>
            </div>

            <div>
                <input type="radio" id="radioLine" name="displayObj" class="radio" value="Line"/>
                <label for="Line" class="text-base-content label p-2">Line</label>
            </div>

            <div>
                <input type="radio" id="radioDot" name="displayObj" class="radio" value="Dot"/>
                <label for="Dot" class="text-base-content label p-2">Dot</label>
            </div>
        </fieldset>

        <fieldset id="gridSettings" class="fieldset bg-base-200 border-base-300 rounded-box w-auto border p-1 md:p-3 md:text-xl align-middle">
            <legend class="fieldset-legend">Settings</legend>

            <div>
                <label for="gridStepRange" class="text-base-content label p-0.5 md:p-2 tooltip" data-tip="Number of lines in each direction from mouse">Steps 🛈:</label>
                <div class="w-full max-w-xs grid grid-cols-10 align-middle gap-1">
                    <input name = "gridStepRange" id = "gridStepRange" type="range" min="1" max="10" value="3" class="range h-full col-span-10" step="1" list="volumeTicks"/>
                    <p class="text-xl text-center">1</p>
                    <p class="text-xl text-center">2</p>
                    <p class="text-xl text-center">3</p>
                    <p class="text-xl text-center">4</p>
                    <p class="text-xl text-center">5</p>
                    <p class="text-xl text-center">6</p>
                    <p class="text-xl text-center">7</p>
                    <p class="text-xl text-center">8</p>
                    <p class="text-xl text-center">9</p>
                    <p class="text-xl text-center">10</p>
                </div>
            </div>

            <div class="flex">
                <label for="gridStepSize" class="text-base-content label p-0.5 md:p-2 tooltip pr-2" data-tip="Distance between lines (Accepts same input as f(z))">Step Size 🛈:</label>
                <input id ="gridStepSize" name ="gridStepSize" type="text" class="w-full md:text-xl p-1" placeholder="1">
            </div>
        </fieldset>

        <fieldset id="circSettings" class="fieldset bg-base-200 border-base-300 rounded-box w-auto border p-1 md:p-3 md:text-xl align-middle" hidden>
            <legend class="fieldset-legend">Settings</legend>

            <div class="flex">
                <label for="circRadius" class="text-base-content label p-0.5 md:p-2 pr-2">
                    Radius:</label>
                <input id ="circRadius" name ="circRadius" type="text" class="w-full md:text-xl p-1" placeholder="1">
            </div>
        </fieldset>

        <fieldset id="lineSettings" class="fieldset bg-base-200 border-base-300 rounded-box w-auto border p-1 md:p-3 md:text-xl align-middle" hidden>
            <legend class="fieldset-legend">How to</legend>
            <p>Click to place  a point for it to be the first point of your line, your mouse serves as second point to define the line.</p>
        </fieldset>

        <fieldset id="dotSettings" class="fieldset bg-base-200 border-base-300 rounded-box w-auto border p-1 md:p-3 md:text-xl align-middle" hidden>
            <legend class="fieldset-legend">Settings</legend>

            <label for="showRDiff" class="text-base-content label p-0.5 md:p-2 pr-2 align-middle">
                <input id ="showRDiff" name ="showRDiff" type="checkbox" class="checkbox align-middle checkbox-md">
                    Show Differential in $\Bbb R$ direction
            </label>
            
            <label for="showIDiff" class="text-base-content label p-0.5 md:p-2 pr-2 align-middle">
                <input id ="showIDiff" name ="showIDiff" type="checkbox" class="checkbox align-middle checkbox-md">
                    Show Differential in $i \Bbb R$ direction
            </label>
        </fieldset>
    </div>
</div>


<script>
    import Complex from 'complex.js';

    const TAU = Complex.PI.mul(2)

    const canvas = document.getElementById("ComplexFunc") as HTMLCanvasElement;
    const ctx : CanvasRenderingContext2D = canvas.getContext("2d") as CanvasRenderingContext2D;

    const input = document.getElementById("function-input") as HTMLInputElement;

    const radioGrid = document.getElementById("radioGrid") as HTMLInputElement;
    const radioCirc = document.getElementById("radioCirc") as HTMLInputElement;
    const radioLine = document.getElementById("radioLine") as HTMLInputElement;
    const radioDot = document.getElementById("radioDot") as HTMLInputElement;

    const gridSettings = document.getElementById("gridSettings") as HTMLFieldSetElement;
    const gridStepRange = document.getElementById("gridStepRange") as HTMLInputElement;
    const gridStepSize = document.getElementById("gridStepSize") as HTMLInputElement;

    const circSettings = document.getElementById("circSettings") as HTMLFieldSetElement;
    const circRadius = document.getElementById("circRadius") as HTMLInputElement;

    const lineSettings = document.getElementById("lineSettings") as HTMLFieldSetElement;

    const dotSettings = document.getElementById("dotSettings") as HTMLFieldSetElement;
    const checkbowRDiff = document.getElementById("showRDiff") as HTMLInputElement;
    const checkbowIDiff = document.getElementById("showIDiff") as HTMLInputElement;

    let f: Function = (z : Complex) => {
        return Complex.E.pow(z);
    }

    function funcListener() {
        let cf = parseFunc(input.value)
        if (cf == null && input.value != ""){
            input.classList.add("text-error")
        } else {
            input.classList.remove("text-error")
            if (cf != null) f = cf;
            else f = (z : Complex) => {return Complex.E.pow(z);}
            updateNeeded = true;
        }
    }
    input.addEventListener("input", (e) => {funcListener()})
    window.addEventListener("load", (e) => {console.log("loaded");funcListener()})

    function validBracketing(s:  string) : boolean{
        let bl = 0
        for (let i = 0; i < s.length; i++) {
            if (s.at(i) == "(") bl++;
            if (s.at(i) == ")") bl--;

            if (bl < 0) return false;
        }
        return bl == 0;
    }

    function findFirstUnbracketed(c : string, s:  string) : number{
        let bl = 0
        for (let i = 0; i <= s.length - c.length; i++) {
            if (s.at(i) == "(") bl++;
            if (s.at(i) == ")") bl--;

            if (bl == 0 && c == s.substring(i, i+c.length)) return i;
        }
        return -1;
    }

    function findFirstUnbracketedMul(s:  string) : number{
        let bl = 0
        for (let i = 0; i <= s.length; i++) {
            if (s.at(i) == "(") bl++;
            if (s.at(i) == ")") bl--;

            if (bl == 0 && '*' == s.at(i) && !s.substring(i+1).startsWith("*") && !s.substring(0,i).endsWith("*")) return i;
        }
        return -1;
    }

    function isNumeric(str : any) {
        if (typeof str != "string") return false 
        return !isNaN(+str) && !isNaN(parseFloat(str))
    }


    function parseFunc(s : string) : Function | null{
        s = s.trim()

        while(s.indexOf("|") != -1){
            s = s.replace("|","abs(")
            if (s.indexOf("|") == -1) return null;
            s = s.replace("|",")")
        }

        if(!validBracketing(s)) return null

        
        while (s.startsWith("(") && s.endsWith(")")){
            let cs = s.substring(1,s.length-1).trim()
            if (validBracketing(cs)) s = cs;
            else break;
        }

        if (isNumeric(s)){
            return (z : Complex) => {return Complex(parseFloat(s))} 
        }

        if (s=="i"){
            return (z : Complex) => {return Complex.I} 
        }

        if (s=="e"){
            return (z : Complex) => {return Complex.E} 
        }

        if (s=="p"){
            return (z : Complex) => {return Complex.PI} 
        }

        if (s=="t"){
            return (z : Complex) => {return TAU} 
        }

        if (s=="z"){
            return (z : Complex) => {return z} 
        }

        if (s.endsWith("i") && isNumeric(s.substring(0,s.length-1).trim())){
            return (z : Complex) => {return Complex(0,parseFloat(s.substring(0,s.length).trim()))} 
        }

        let i = findFirstUnbracketed("+", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))

            if (lf == null && s.substring(0,i).trim() == ""){
                lf = (z : Complex) => {return Complex.ZERO};
            }

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).add(rf(z))};
        }
        
        i = findFirstUnbracketed("-", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))


            if (lf == null && s.substring(0,i).trim() == ""){
                lf = (z : Complex) => {return Complex.ZERO};
            }
                

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).sub(rf(z))};
        }

        i = findFirstUnbracketedMul(s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).mul(rf(z))};
        }

        i = findFirstUnbracketed("/", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).div(rf(z))};
        }

        i = findFirstUnbracketed("**", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+2))

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).pow(rf(z))};
        }

        if (s.startsWith("sinh")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).sinh()}
        }

        if (s.startsWith("cosh")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).cosh()}
        }

        if (s.startsWith("sin")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).sin()}
        }

        if (s.startsWith("cos")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).cos()}
        }

        if (s.startsWith("conj")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).conjugate()}
        }

        if (s.startsWith("Re")){
            let rf = parseFunc(s.substring(2))
            
            if (rf == null) return null;
            
            return (z : Complex) => {let w = rf(z); return (w.add(w.conjugate())).div(2)}
        }

        if (s.startsWith("Im")){
            let rf = parseFunc(s.substring(2))
            
            if (rf == null) return null;
            
            return (z : Complex) => {let w = rf(z); return (w.sub(w.conjugate())).div(Complex(0,2))}
        }

        if (s.startsWith("abs")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).abs())}
        }

        if (s.startsWith("arg")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).arg())}
        }
        
        if (s.startsWith("exp")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).exp())}
        }

        if (s.startsWith("tanh")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).tanh())}
        }

        if (s.startsWith("tan")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).tan())}
        }

        if (s.startsWith("asinh")){
            let rf = parseFunc(s.substring(5))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).asinh())}
        }

        if (s.startsWith("acosh")){
            let rf = parseFunc(s.substring(5))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).acosh())}
        }

        if (s.startsWith("atanh")){
            let rf = parseFunc(s.substring(5))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).atanh())}
        }

        if (s.startsWith("asin")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).asin())}
        }

        if (s.startsWith("acos")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).acos())}
        }

        if (s.startsWith("atan")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).atan())}
        }

        return null;
    }

    let zoom = 50

    let mode = "GRID"

    let N = 3
    let s :Complex = Complex(1)

    let r :Complex = Complex(1)

    let z0 : Complex = Complex.ZERO

    let doRDiff = false
    let doIDiff = false

    let x = 0;
    let y = 0;
    let updateNeeded = true;

    canvas.addEventListener("mousemove", (e) => {
        var rect = canvas.getBoundingClientRect(), // abs. size of element
        scaleX = canvas.width / rect.width,    // relationship bitmap vs. element for x
        scaleY = canvas.height / rect.height;  // relationship bitmap vs. element for y

        x = (e.clientX - rect.left) * scaleX
        y = (e.clientY - rect.top) * scaleY

        updateNeeded = true;
    });

    canvas.addEventListener("mousedown", (e) => {
        if (e.button != 0) return;

        var rect = canvas.getBoundingClientRect(), // abs. size of element
        scaleX = canvas.width / rect.width,    // relationship bitmap vs. element for x
        scaleY = canvas.height / rect.height;  // relationship bitmap vs. element for y

        x = (e.clientX - rect.left) * scaleX
        y = (e.clientY - rect.top) * scaleY

        if (10 <= x && x <= 50){
            if (10 <= y && y <= 90){
                zoom *= 1 + +(y <= 50)
                zoom /= 1 + +(y >= 50)
            }
        }

        updateNeeded = true;
    });

    function gridStepRangeListener(){
        if (!isNumeric(gridStepRange.value)){
            console.log(gridStepRange.value)
            gridStepRange.classList.add("text-error")
        } else {
            gridStepRange.classList.remove("text-error")
            N = parseInt(gridStepRange.value)
            updateNeeded = true;
        }
    }
    gridStepRange.addEventListener("input", (e) => {gridStepRangeListener()})
    window.addEventListener("load", (e) => {gridStepRangeListener()})

    function gridStepSizeListener(){
        let cf = parseFunc(gridStepSize.value)
        if (gridStepSize.value.includes("z") || (cf == null && gridStepSize.value != "")){
            gridStepSize.classList.add("text-error")
        } else {
            gridStepSize.classList.remove("text-error")
            if (cf != null) s = cf(Complex.ZERO);
            else s = Complex.ONE;
            updateNeeded = true;
        }
    }
    gridStepSize.addEventListener("input", (e) => {gridStepSizeListener()})
    window.addEventListener("load", (e) => {gridStepSizeListener()})

    function circRadiusListener() {
        let cf = parseFunc(circRadius.value)
        if (circRadius.value.includes("z") || (cf == null && circRadius.value != "")){
            circRadius.classList.add("text-error")
        } else {
            circRadius.classList.remove("text-error")
            if (cf != null) r = cf(Complex.ZERO);
            else r = Complex.ONE;
            updateNeeded = true;
        }
    }
    circRadius.addEventListener("input", (e) => {circRadiusListener()})
    window.addEventListener("load", (e) => {circRadiusListener()})

    canvas.addEventListener("mousedown", (e) => {
        if (e.button != 0) return;
        if (mode != "LINE") return;

        var rect = canvas.getBoundingClientRect(), // abs. size of element
        scaleX = canvas.width / rect.width,    // relationship bitmap vs. element for x
        scaleY = canvas.height / rect.height;  // relationship bitmap vs. element for y

        x = (e.clientX - rect.left) * scaleX
        y = (e.clientY - rect.top) * scaleY

        if (10 <= x && x <= 50){
            if (10 <= y && y <= 90){
                return
            }
        }

        z0 = ScreentoC(x,y);

        updateNeeded = true;
    })

    function checkbowDiffListener(){
        doRDiff = checkbowRDiff.checked
        doIDiff = checkbowIDiff.checked
        updateNeeded = true
    }
    checkbowRDiff.addEventListener("input", checkbowDiffListener)
    checkbowIDiff.addEventListener("input", checkbowDiffListener)
    window.addEventListener("load", checkbowDiffListener)

    function modeSelectionListener (e: Event) {
        if (radioGrid.checked) mode = "GRID";
        else if (radioCirc.checked) mode = "CIRC";
        else if (radioLine.checked) mode = "LINE";
        else if (radioDot.checked) mode = "DOT";

        gridSettings.hidden = mode != "GRID";
        circSettings.hidden = mode != "CIRC";
        lineSettings.hidden = mode != "LINE";
        dotSettings.hidden = mode != "DOT";

        updateNeeded = true;
    }

    radioGrid.addEventListener("input", modeSelectionListener)
    radioCirc.addEventListener("input", modeSelectionListener)
    radioLine.addEventListener("input", modeSelectionListener)
    radioDot.addEventListener("input", modeSelectionListener)
    window.addEventListener("load", modeSelectionListener)

    function screentf(x : number, y : number) : [number,number] {return [x+canvas.width/2, y+canvas.height/2]}
    function invScreentf(x : number, y : number) : [number,number] {return [x-canvas.width/2, y-canvas.height/2]}

    function CtoScreen(z : Complex) : [number,number]{return [z.re*zoom+canvas.width/2, z.im*zoom+canvas.height/2]}
    function ScreentoC(x : number, y : number){ return Complex(x-canvas.width/2, (y-canvas.height/2)).div(zoom)}


    function CtoColor(z : Complex) : string{
        let rdir = Complex.E.pow(Complex.PI.mul(Complex(0,0)))
        let gdir = Complex.E.pow(Complex.PI.mul(Complex(0,2/3)))
        let bdir= Complex.E.pow(Complex.PI.mul(Complex(0,4/3)))


        let rraw = z.re * rdir.re + z.im * rdir.im
        let graw = z.re * gdir.re + z.im * gdir.im
        let braw = z.re * bdir.re + z.im * bdir.im

        let C = 300/N;
        rraw *= C, graw *= C, braw *= C

        //console.log("rgb(" + Math.min(255,Math.max(rraw,0)) +","+ Math.min(255,Math.max(graw,0)) + "," + Math.min(255,Math.max(braw,0)) +")")

        return "rgb(" + Math.min(255,Math.max(rraw,0)) +","+ Math.min(255,Math.max(graw,0)) + "," + Math.min(255,Math.max(braw,0)) +")"
    }

    function drawScrollButtons(){
        ctx.fillStyle = "#22222222"
        ctx.beginPath()
        ctx.rect(10,30,40,40)
        ctx.ellipse(30,30,20,20,0,0,360)
        ctx.ellipse(30,70,20,20,0,0,360)
        ctx.fill()

        // divider
        ctx.fillStyle = "#00000022"
        ctx.fillRect(10,49,40,2)
        
        // +
        ctx.fillStyle = "#00000044"
        ctx.beginPath()
        ctx.rect(20,28,20,4)
        ctx.rect(28,20,4,20)
        ctx.fill()

        // -
        ctx.fillStyle = "#00000044"
        ctx.beginPath()
        ctx.rect(20,68,20,4)
        ctx.fill()
    }

    function  drawCoords(){
        ctx.lineWidth = 3
        ctx.strokeStyle = "#000000"
        ctx.beginPath()
        ctx.moveTo(...screentf(0,-canvas.height))
        ctx.lineTo(...screentf(0,canvas.height))
        ctx.moveTo(...screentf(-canvas.width,0))
        ctx.lineTo(...screentf(canvas.width,0))

        for (let i = Math.floor(-canvas.width/zoom); i < canvas.width/zoom; i++) {
            ctx.moveTo(...CtoScreen(Complex(i, -0.1)));
            ctx.lineTo(...CtoScreen(Complex(i, +0.1)));
        }

        for (let i = Math.floor(-canvas.height/zoom); i < canvas.height/zoom; i++) {
            ctx.moveTo(...CtoScreen(Complex(-0.1, i)));
            ctx.lineTo(...CtoScreen(Complex(+0.1, i)));
        }
        ctx.stroke()
    }

    function drawMouseGrid(c : string, f : Function){
        ctx.lineWidth = 3
        ctx.strokeStyle = c
        ctx.beginPath()

        let z = ScreentoC(x,y)
        for (let i = -N; i <= N; i++) {
            for (let j = -N; j < N; j += 0.01){
                ctx.moveTo(...CtoScreen(f(z.add(s.mul(Complex(i, j))))));
                ctx.lineTo(...CtoScreen(f(z.add(s.mul(Complex(i, j + 0.01))))));
            }
        }
        for (let i = -N; i <= N; i++) {
            for (let j = -N; j < N; j += 0.01){
                ctx.moveTo(...CtoScreen(f(z.add(s.mul(Complex(j, i))))));
                ctx.lineTo(...CtoScreen(f(z.add(s.mul(Complex(j + 0.01, i))))));
            }
        }

        ctx.stroke();
    }

    function drawColorGrid(f : Function, z : Complex){
        ctx.lineWidth = 3
        ctx.beginPath()

        let M = N

        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.01){
                ctx.strokeStyle = CtoColor(Complex(i, j));
                ctx.moveTo(...CtoScreen(f(z.add(s.mul(Complex(i, j))))));
                ctx.lineTo(...CtoScreen(f(z.add(s.mul(Complex(i, j + 0.01))))));
                ctx.stroke();
                ctx.beginPath()
            }
        }
        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.01){
                ctx.strokeStyle = CtoColor(Complex(j, i));
                ctx.moveTo(...CtoScreen(f(z.add(s.mul(Complex(j, i))))));
                ctx.lineTo(...CtoScreen(f(z.add(s.mul(Complex(j + 0.01, i))))));
                ctx.stroke();
                ctx.beginPath()
            }
        }

        ctx.stroke();
    }

    function drawColorGridDashed(f : Function, z : Complex){
        ctx.lineWidth = 3
        ctx.beginPath()

        let M = N

        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.04){
                ctx.strokeStyle = CtoColor(Complex(i, j));
                ctx.moveTo(...CtoScreen(f(z.add(s.mul(Complex(i, j))))));
                ctx.lineTo(...CtoScreen(f(z.add(s.mul(Complex(i, j + 0.01))))));
                ctx.stroke();
                ctx.beginPath()
            }
        }
        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.04){
                ctx.strokeStyle = CtoColor(Complex(j, i));
                ctx.moveTo(...CtoScreen(f(z.add(s.mul(Complex(j, i))))));
                ctx.lineTo(...CtoScreen(f(z.add(s.mul(Complex(j + 0.01, i))))));
                ctx.stroke();
                ctx.beginPath()
            }
        }

        ctx.stroke();
    }

    function drawCirc(f : Function, z : Complex){
        ctx.lineWidth = 3

        let numPts = 10000

        for (let i = 0; i < numPts; i++) {
            let alpha = Complex(0, 2*Math.PI*i/numPts)
            let beta = Complex(0, 2*Math.PI*(i+1)/numPts)

            ctx.strokeStyle = "hsl("+(360*i/numPts)+",100%,50%)";
            ctx.beginPath()
            ctx.moveTo(...CtoScreen(f(z.add(r.mul(alpha.exp())))));
            ctx.lineTo(...CtoScreen(f(z.add(r.mul(beta.exp())))));
            ctx.stroke();
        }
    }

    function drawCircDashed(f : Function, z : Complex){
        ctx.lineWidth = 3

        let numPts = 45

        for (let i = 0; i < numPts; i++) {
            let alpha = Complex(0, 2*Math.PI*i/numPts)
            let beta = Complex(0, 2*Math.PI*(i+0.5)/numPts)

            ctx.strokeStyle = "hsl("+(360*i/numPts)+",100%,50%)";
            ctx.beginPath()
            ctx.moveTo(...CtoScreen(f(z.add(r.mul(alpha.exp())))));
            ctx.lineTo(...CtoScreen(f(z.add(r.mul(beta.exp())))));
            ctx.stroke();
        }
    }

    function drawLine(f : Function, z : Complex, w : Complex){
        ctx.lineWidth = 3

        let numPts = 20000

        let step : Complex = z.sub(w)

        step = step.div(step.abs()*zoom)

        let K = Math.max(3*zoom/canvas.width, 3*zoom/canvas.height)/100

        for (let i = -numPts; i <= numPts; i++) {
            ctx.strokeStyle = "hsl("+180*(((2)/(1+Math.exp(K*i)))-1)+",100%,50%)";
            ctx.beginPath()
            ctx.moveTo(...CtoScreen(f(w.add(step.mul(i)))));
            ctx.lineTo(...CtoScreen(f(w.add(step.mul(i+1)))));
            ctx.stroke();
        }
    }

    function drawLineDashed(f : Function, z : Complex, w : Complex){
        ctx.lineWidth = 3

        let numPts = 1000

        let step : Complex = z.sub(w)

        step = step.div(10*step.abs()*zoom/50)

        let K = Math.max(15/canvas.width, 15/canvas.height)

        for (let i = -numPts; i <= numPts; i++) {
            ctx.strokeStyle = "hsl("+180*(((2)/(1+Math.exp(K*i)))-1)+",100%,50%)";
            ctx.beginPath()
            ctx.moveTo(...CtoScreen(f(w.add(step.mul(i)))));
            ctx.lineTo(...CtoScreen(f(w.add(step.mul(i+0.5)))));
            ctx.stroke();
        }
    }

    function drawDot(z: Complex, c :string){
        ctx.fillStyle = c
        ctx.beginPath()
        ctx.ellipse(...CtoScreen(z),5,5,0,0,360)
        ctx.fill()
    }

    function numericDiff(f : Function, z: Complex, v: Complex){
        v = v.div(v.abs())


        let delta = 0.000001
        let diffs : Complex[] = [f(z.add(v.mul(delta))).sub(f(z)).div(delta)]
        do {
            diffs.push(f(z.add(v.mul(delta))).sub(f(z)).div(delta))
        } while (diffs.length < 4 ||
                1.1 < diffs[diffs.length - 1].abs()/diffs[diffs.length - 2].abs() ||
                0.9 > diffs[diffs.length - 1].abs()/diffs[diffs.length - 2].abs() ||
                1.1 < diffs[diffs.length - 2].abs()/diffs[diffs.length - 3].abs() ||
                0.9 > diffs[diffs.length - 2].abs()/diffs[diffs.length - 3].abs())
        return diffs[diffs.length-1]
    }

    function drawDiff(f: Function, z: Complex, c :string, v: Complex){
        let d = numericDiff(f,z,v)

        ctx.strokeStyle = c
        ctx.beginPath()

        ctx.moveTo(...CtoScreen(f(z)));
        ctx.lineTo(...CtoScreen(f(z).add(d)));

        ctx.moveTo(...CtoScreen(f(z).add(d.mul(Complex(0.9,0.1)))));
        ctx.lineTo(...CtoScreen(f(z).add(d)));

        ctx.moveTo(...CtoScreen(f(z).add(d.mul(Complex(0.9,-0.1)))));
        ctx.lineTo(...CtoScreen(f(z).add(d)));

        ctx.stroke();
    }

    function mainloop(){
        if (!updateNeeded) {setTimeout(mainloop,5); return} 
        updateNeeded = false;

        ctx.fillStyle = "#ffffff"
        ctx.fillRect(-5,-5, canvas.width+10, canvas.height+10)

        drawCoords();

        let z = ScreentoC(x,y)

        if (mode == "GRID"){
            //drawMouseGrid("#0000ff", (x : Complex) => {return x});
            //drawMouseGrid("#ff0000", f);

            drawColorGridDashed((x : Complex) => {return x}, z);
            drawColorGrid(f, z);
        } else if (mode == "CIRC"){
            drawCircDashed((x : Complex) => {return x}, z)
            drawCirc(f, z)
        } else if (mode == "LINE"){
            drawLineDashed((x : Complex) => {return x}, z, z0)
            drawLine(f, z, z0)
        } else if (mode == "DOT"){
            if (doRDiff) drawDiff((x : Complex) => {return x},z,"#00ff00", Complex.ONE)
            if (doIDiff) drawDiff((x : Complex) => {return x},z,"#00ffff", Complex.I)
            if (doRDiff) drawDiff(f,z,"#00ff00", Complex.ONE)
            if (doIDiff) drawDiff(f,z,"#00ffff", Complex.I)
            drawDot(z, "#0000ff")
            drawDot(f(z), "#ff0000")
        }

        drawScrollButtons();

        setTimeout(mainloop,5)
    }


    mainloop();
</script>