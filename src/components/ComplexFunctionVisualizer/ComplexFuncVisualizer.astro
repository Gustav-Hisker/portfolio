<canvas id="ComplexFunc" width="2000", height="1000" style='width:100%; height:47vw;'></canvas>
<div class="p-2">
    <div class="flex align-middle">
    <h2 class="text-2xl flex-none p-2">f(z) =</h2>
    <input class="w-full text-2xl p-2" id="function-input" type="text" name="function" placeholder="e**z">
    </div>
    <p class="text-info text-xl p-2">Allowed symbols and Operators: z, (Complex) Numbers (e.g 13.37, 42i, 13 + 23i, ...), +, -, *, /, ** (= ^), i, e, t(=τ), p(=π), sin, cos, sinh, cosh, Re, Im, conj (= conjuate)), abs, |⋅|, arg</p>
</div>


<script>
    import Complex from 'complex.js';

    const TAU = Complex.PI.mul(2)

    const canvas = document.getElementById("ComplexFunc") as HTMLCanvasElement;
    const ctx : CanvasRenderingContext2D = canvas.getContext("2d") as CanvasRenderingContext2D;

    const input = document.getElementById("function-input") as HTMLInputElement;


    let f: Function = (z : Complex) => {
        return Complex.E.pow(z);
    }

    input.addEventListener("input", (e) => {
        let cf = parseFunc(input.value)
        if (cf == null && input.value != ""){
            input.classList.add("text-error")
        } else {
            input.classList.remove("text-error")
            if (cf != null) f = cf;
            else f = (z : Complex) => {return Complex.E.pow(z);}
            updateNeeded = true;
        }
    })

    function validBracketing(s:  string) : boolean{
        let bl = 0
        for (let i = 0; i < s.length; i++) {
            if (s.at(i) == "(") bl++;
            if (s.at(i) == ")") bl--;

            if (bl < 0) return false;
        }
        return bl == 0;
    }

    function findFirstUnbracketed(c : string, s:  string) : number{
        let bl = 0
        for (let i = 0; i <= s.length - c.length; i++) {
            if (s.at(i) == "(") bl++;
            if (s.at(i) == ")") bl--;

            if (bl == 0 && c == s.substring(i, i+c.length)) return i;
        }
        return -1;
    }

    function isNumeric(str : any) {
        if (typeof str != "string") return false 
        return !isNaN(+str) && !isNaN(parseFloat(str))
    }


    function parseFunc(s : string) : Function | null{
        s = s.trim()

        while(s.indexOf("|") != -1){
            s = s.replace("|","abs(")
            if (s.indexOf("|") == -1) return null;
            s = s.replace("|",")")
        }

        if(!validBracketing(s)) return null

        
        while (s.startsWith("(") && s.endsWith(")")){
            let cs = s.substring(1,s.length-1).trim()
            if (validBracketing(cs)) s = cs;
            else break;
        }

        if (isNumeric(s)){
            return (z : Complex) => {return Complex(parseFloat(s))} 
        }

        if (s=="i"){
            return (z : Complex) => {return Complex.I} 
        }

        if (s=="e"){
            return (z : Complex) => {return Complex.E} 
        }

        if (s=="p"){
            return (z : Complex) => {return Complex.PI} 
        }

        if (s=="t"){
            return (z : Complex) => {return TAU} 
        }

        if (s=="z"){
            return (z : Complex) => {return z} 
        }

        if (s.endsWith("i") && isNumeric(s.substring(0,s.length-1).trim())){
            return (z : Complex) => {return Complex(0,parseFloat(s.substring(0,s.length).trim()))} 
        }

        let i = findFirstUnbracketed("+", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))

            if (lf == null && s.substring(0,i).trim() == ""){
                lf = (z : Complex) => {return Complex.ZERO};
            }

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).add(rf(z))};
        }
        
        i = findFirstUnbracketed("-", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))


            if (lf == null && s.substring(0,i).trim() == ""){
                lf = (z : Complex) => {return Complex.ZERO};
            }
                

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).sub(rf(z))};
        }

        i = findFirstUnbracketed("*", s)
        if (i != -1 && (s.at(i+1) != "*")){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).mul(rf(z))};
        }

        i = findFirstUnbracketed("/", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+1))

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).div(rf(z))};
        }

        i = findFirstUnbracketed("**", s)
        if (i != -1){
            let lf = parseFunc(s.substring(0,i))
            let rf = parseFunc(s.substring(i+2))

            if (lf == null) return null;
            if (rf == null) return null;

            return (z : Complex) => {return lf(z).pow(rf(z))};
        }

        if (s.startsWith("sinh")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).sinh()}
        }

        if (s.startsWith("cosh")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).cosh()}
        }

        if (s.startsWith("sin")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).sin()}
        }

        if (s.startsWith("cos")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).cos()}
        }

        if (s.startsWith("conj")){
            let rf = parseFunc(s.substring(4))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return rf(z).conjugate()}
        }

        if (s.startsWith("Re")){
            let rf = parseFunc(s.substring(2))
            
            if (rf == null) return null;
            
            return (z : Complex) => {let w = rf(z); return (w.add(w.conjugate())).div(2)}
        }

        if (s.startsWith("Im")){
            let rf = parseFunc(s.substring(2))
            
            if (rf == null) return null;
            
            return (z : Complex) => {let w = rf(z); return (w.sub(w.conjugate())).div(Complex(0,2))}
        }

        if (s.startsWith("abs")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).abs())}
        }

        if (s.startsWith("arg")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).arg())}
        }
        
        if (s.startsWith("exp")){
            let rf = parseFunc(s.substring(3))
            
            if (rf == null) return null;
            
            return (z : Complex) => {return Complex(rf(z).exp())}
        }

        return null;
    }

    const zoom = 50
    const N = 3

    let x = 0;
    let y = 0;
    let updateNeeded = true;

    canvas.addEventListener("mousemove", (e) => {
        var rect = canvas.getBoundingClientRect(), // abs. size of element
        scaleX = canvas.width / rect.width,    // relationship bitmap vs. element for x
        scaleY = canvas.height / rect.height;  // relationship bitmap vs. element for y

        x = (e.clientX - rect.left) * scaleX
        y = (e.clientY - rect.top) * scaleY

        updateNeeded = true;
    });

    function screentf(x : number, y : number) : [number,number] {return [x+canvas.width/2, y+canvas.height/2]}
    function invScreentf(x : number, y : number) : [number,number] {return [x-canvas.width/2, y-canvas.height/2]}

    function CtoScreen(z : Complex) : [number,number]{return [z.re*zoom+canvas.width/2, z.im*zoom+canvas.height/2]}
    function ScreentoC(x : number, y : number){ return Complex(x-canvas.width/2, (y-canvas.height/2)).div(zoom)}


    function CtoColor(z : Complex) : string{
        let rdir = Complex.E.pow(Complex.PI.mul(Complex(0,0)))
        let gdir = Complex.E.pow(Complex.PI.mul(Complex(0,2/3)))
        let bdir= Complex.E.pow(Complex.PI.mul(Complex(0,4/3)))


        let rraw = z.re * rdir.re + z.im * rdir.im
        let graw = z.re * gdir.re + z.im * gdir.im
        let braw = z.re * bdir.re + z.im * bdir.im

        let C = 100;
        rraw *= C, graw *= C, braw *= C

        //console.log("rgb(" + Math.min(255,Math.max(rraw,0)) +","+ Math.min(255,Math.max(graw,0)) + "," + Math.min(255,Math.max(braw,0)) +")")

        return "rgb(" + Math.min(255,Math.max(rraw,0)) +","+ Math.min(255,Math.max(graw,0)) + "," + Math.min(255,Math.max(braw,0)) +")"
    }



    function  drawCoords(){
        ctx.lineWidth = 3
        ctx.strokeStyle = "#000000"
        ctx.beginPath()
        ctx.moveTo(...screentf(0,-canvas.height))
        ctx.lineTo(...screentf(0,canvas.height))
        ctx.moveTo(...screentf(-canvas.width,0))
        ctx.lineTo(...screentf(canvas.width,0))

        for (let i = Math.floor(-canvas.width/zoom); i < canvas.width/zoom; i++) {
            ctx.moveTo(...CtoScreen(Complex(i, -0.1)));
            ctx.lineTo(...CtoScreen(Complex(i, +0.1)));
        }

        for (let i = Math.floor(-canvas.height/zoom); i < canvas.height/zoom; i++) {
            ctx.moveTo(...CtoScreen(Complex(-0.1, i)));
            ctx.lineTo(...CtoScreen(Complex(+0.1, i)));
        }
        ctx.stroke()
    }

    function drawMouseGrid(c : string, f : Function){
        ctx.lineWidth = 3
        ctx.strokeStyle = c
        ctx.beginPath()

        let z = ScreentoC(x,y)
        for (let i = -N; i <= N; i++) {
            for (let j = -N; j < N; j += 0.01){
                ctx.moveTo(...CtoScreen(f(z.add(Complex(i, j)))));
                ctx.lineTo(...CtoScreen(f(z.add(Complex(i, j + 0.01)))));
            }
        }
        for (let i = -N; i <= N; i++) {
            for (let j = -N; j < N; j += 0.01){
                ctx.moveTo(...CtoScreen(f(z.add(Complex(j, i)))));
                ctx.lineTo(...CtoScreen(f(z.add(Complex(j + 0.01, i)))));
            }
        }

        ctx.stroke();
    }

    function drawColorGrid(f : Function, z : Complex){
        ctx.lineWidth = 3
        ctx.beginPath()

        let M = N

        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.01){
                ctx.strokeStyle = CtoColor(Complex(i, j));
                ctx.moveTo(...CtoScreen(f(z.add(Complex(i, j)))));
                ctx.lineTo(...CtoScreen(f(z.add(Complex(i, j + 0.01)))));
                ctx.stroke();
                ctx.beginPath()
            }
        }
        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.01){
                ctx.strokeStyle = CtoColor(Complex(j, i));
                ctx.moveTo(...CtoScreen(f(z.add(Complex(j, i)))));
                ctx.lineTo(...CtoScreen(f(z.add(Complex(j + 0.01, i)))));
                ctx.stroke();
                ctx.beginPath()
            }
        }

        ctx.stroke();
    }

    function drawColorGridDashed(f : Function, z : Complex){
        ctx.lineWidth = 3
        ctx.beginPath()

        let M = N

        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.04){
                ctx.strokeStyle = CtoColor(Complex(i, j));
                ctx.moveTo(...CtoScreen(f(z.add(Complex(i, j)))));
                ctx.lineTo(...CtoScreen(f(z.add(Complex(i, j + 0.01)))));
                ctx.stroke();
                ctx.beginPath()
            }
        }
        for (let i = -M; i <= M; i++) {
            for (let j = -M; j < M; j += 0.04){
                ctx.strokeStyle = CtoColor(Complex(j, i));
                ctx.moveTo(...CtoScreen(f(z.add(Complex(j, i)))));
                ctx.lineTo(...CtoScreen(f(z.add(Complex(j + 0.01, i)))));
                ctx.stroke();
                ctx.beginPath()
            }
        }

        ctx.stroke();
    }

    function mainloop(){
        if (!updateNeeded) {setTimeout(mainloop,5); return} 
        updateNeeded = false;

        ctx.fillStyle = "#ffffff"
        ctx.fillRect(-5,-5, canvas.width+10, canvas.height+10)

        drawCoords();

        
        // drawMouseGrid("#0000ff", (x : Complex) => {return x});
        // drawMouseGrid("#ff0000", f);

        drawColorGridDashed((x : Complex) => {return x}, ScreentoC(x,y));
        drawColorGrid(f, ScreentoC(x,y));

             
        setTimeout(mainloop,5)
    }


    mainloop();
</script>