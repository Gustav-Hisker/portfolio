<script id="workerd" type="javascript">
let q = 1n
let r = 0n
let t = 1n
let k = 1n
let n = 3n
let l = 3n
let pi = ""
let length = 0
let currRoutine = 0

let nextPublish = 0;

function next(){
    if (4n * q + r - t < n * t){
        pi += n;
        length++;
        let nn = (10n * (3n * q + r)) / t - 10n * n;
        r = 10n * (r - n * t);
        n = nn;
        q *= 10n;
    }
    else{
        t *= l;
        n = (q * (7n * k + 2n) + r * l) / t;
        r = (2n * q + r) * l;
        q *= k;
        k += 1n;
        l += 2n;
    }
}

function sleep(fff) {
  return new Promise(rs => setTimeout(rs, fff));
}


async function find(y,w){
    let x = ++currRoutine;
    while (currRoutine == x && length < y + w + 2){
        try {
            next();
        } catch (e) {
            postMessage({f: "<span class='text-error'>Integer limit reached.</span>", l:length});
            console.log(q,r,t,k,n,l)
            return;
        }

        if (nextPublish < Date.now()){
            postMessage({f: "Searching...", l:length});
            nextPublish = Date.now()+500;
            await sleep(1);
        }
    }

    searchWord = pi.substring(y, y+w)
    if (y==0) {
        searchWord = "3." + searchWord.substring(1)
    }

    postMessage({f: "At the <span class='text-accent'>" + y + "</span>th to <span class='text-accent'>" + (y+w-1)
        + "</span>th digit of π is " + (y>2?"...":"") + (y>2?pi.substring(y-2, y):(y==0?"":(y==1?"3.":"3.1")))
        +"<span class='text-accent'>"+searchWord+"</span>" + pi.substring(y+w, y+w+2) + "...", l:length});
}


onmessage = (e) => {
    if (/^[0-9]+$/.test(e.data[0]) && /^[0-9]+$/.test(e.data[1])){
        find(parseInt(e.data[0]), parseInt(e.data[1]))
    } else if (e.data[0] != "" && e.data[1] != "") {
        postMessage({f: "Invalid", l:length})
    }
};
</script>


<div class="bg-base-300 shadow-sm w-full p-1 m-1">
    <h1 class="text-4xl">Decry$\pi$t</h1>
    <div class="p-2">
        <input class="w-full text-2xl p-2" id="pi-dec-in" type="text" name="search" placeholder="Enter position to search at">
    </div>
    <div class="p-2">
        <input class="w-full text-2xl p-2" id="pi-dec-dc" type="text" name="search" placeholder="Enter number of digits you search for">
    </div>
    <p class="text-2xl m-3">Searched <span id="piLengthd" class="text-accent">0</span> digits of pi.</p>
    <p id="pi-dec-out" class="text-3xl  m-3" style="word-break: break-word;"></p>
</div>

<script type="text/javascript">
const inputd = document.getElementById("pi-dec-in");
const digitInput = document.getElementById("pi-dec-dc");
const outputd = document.getElementById("pi-dec-out");
const piLengthd = document.getElementById("piLengthd");

var blob = new Blob([document.getElementById("workerd").textContent], { type: "text/javascript" })

var decWorker = new Worker(window.URL.createObjectURL(blob));

function l(e){
    decWorker.postMessage([inputd.value, digitInput.value]);
}

inputd.addEventListener("input", l);
digitInput.addEventListener("input", l);


decWorker.onmessage = (e) => {
  const f = e.data.f;
  const l = e.data.l;
  
  outputd.innerHTML = f;
  piLengthd.innerText = l;
};
</script>